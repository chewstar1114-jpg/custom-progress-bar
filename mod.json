{
  "geode": "4.0.0",
  "gd": {
    "win": "2.2074"
  },
  "id": "yourname.custom-progress-bar",
  "name": "Custom Progress Bar",
  "version": "v1.2.0",
  "developer": "yourname",
  "description": "Progress Bar Studio: 프리셋 선택 + 그림판 스타일 드래그 색 선택(배경/바). 메인 메뉴 하단의 'Bar' 버튼으로 엽니다.",
  "settings": {
    "style": {
      "type": "string",
      "name": "바 스타일",
      "description": "Vanilla = 기본 바 유지, Gradient / Modern = 모드 내장 바 (레벨 재입장 시 적용)",
      "default": "Modern",
      "one-of": ["Vanilla", "Gradient", "Modern"]
    },
    "color-2": {
      "type": "rgb",
      "name": "보조 색상",
      "description": "Gradient의 끝 색 / Modern의 끝부분 글로우 색",
      "default": [180, 120, 255]
    },
    "bar-width": {
      "type": "float",
      "name": "바 가로 길이",
      "default": 240.0,
      "min": 100.0,
      "max": 400.0,
      "control": { "slider": true }
    },
    "bar-height": {
      "type": "float",
      "name": "바 두께",
      "default": 8.0,
      "min": 4.0,
      "max": 24.0,
      "control": { "slider": true }
    },
    "show-percent": {
      "type": "bool",
      "name": "퍼센트 표시",
      "default": true
    }
  }
}
