{
  "geode": "5.7.1",
  "gd": {
    "win": "2.2081",
    "android": "2.2081"
  },
  "id": "yourname.custom-progress-bar",
  "name": "Custom Progress Bar",
  "version": "v1.3.0",
  "developer": "yourname",
  "description": "Progress Bar Studio: 프리셋 선택 + 그림판 스타일 드래그 색 선택(배경/바). 메인 메뉴의 Bar 버튼으로 엽니다.",
  "dependencies": {
    "geode.node-ids": ">=v1.22.0"
  },
  "resources": {
    "sprites": [
      "resources/studio-button.png"
    ]
  },
  "settings": {
    "enabled": {
      "type": "bool",
      "name": "커스텀 프로그래스 바 사용",
      "description": "끄면 기본 프로그래스 바가 그대로 표시됩니다 (레벨 재입장 시 적용)",
      "default": true
    },
    "bar-width": {
      "type": "float",
      "name": "바 가로 길이",
      "default": 240.0,
      "min": 100.0,
      "max": 400.0,
      "control": {
        "slider": true
      }
    },
    "bar-height": {
      "type": "float",
      "name": "바 두께",
      "default": 8.0,
      "min": 4.0,
      "max": 24.0,
      "control": {
        "slider": true
      }
    },
    "show-percent": {
      "type": "bool",
      "name": "퍼센트 표시",
      "default": true
    }
  }
}